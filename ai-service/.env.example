# ── LLM provider ─────────────────────────────────────────────
# "grok" (xAI) or "groq" — both are OpenAI-compatible, one code path.
LLM_PROVIDER=grok

# xAI Grok API key  → https://x.ai/api  (set when provided)
GROK_API_KEY=[REDACTED]

# Groq API key      → https://console.groq.com  (set when provided)
GROQ_API_KEY=[REDACTED]

# ── Embeddings (local, no API key required) ──────────────────
# Swap to an API embedding model (e.g. text-embedding-3-small) if preferred.
EMBEDDINGS_MODEL=sentence-transformers/all-MiniLM-L6-v2

# ── Vector store ─────────────────────────────────────────────
# "chroma" (local, default) or "pinecone" (managed)
VECTORSTORE=chroma
CHROMA_PERSIST_DIR=./chroma
COLLECTION_NAME=merobhawishya_corpus

# Pinecone (only needed if VECTORSTORE=pinecone)
PINECONE_API_KEY=[REDACTED]
PINECONE_INDEX=merobhawishya

# ── Chat service ─────────────────────────────────────────────
CHAT_API_HOST=0.0.0.0
CHAT_API_PORT=8000

# ── Corpus source for ingestion ──────────────────────────────
# "json" reads the seed files; "mongo" reads a running Mongo instance.
CORPUS_SOURCE=json
MONGO_URI=mongodb://localhost:27017/college_choices
